# 가동현: 이건 실제 문서가 아니라 예시 파일임
#        api키들은 깃헙에 올리는 동시에 정지를 먹으니 꼭 개인 env 파일을 만들어 사용할것
#        깃 이그노어에 env 를 넣어놨음!!

# LLM 모델 결정 후 채울 것
LLM_API_KEY=
LLM_BASE_URL=

# Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Ollama (로컬 모델 쓸 경우)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen2.5:7b

# SQLite DB 경로
SQLITE_DB_PATH=storage/sqlite/chat.db

# 파일 저장 경로 (NAS 연결 시 변경)
STORAGE_PATH=storage/uploads

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000

# STT 서버(8002)가 "정밀 재분석 완료" 웹훅을 보낼 때 검증용으로 붙이는 공유 시크릿.
# STT 서버 쪽 REFINE_WEBHOOK_SECRET과 반드시 같은 값으로 맞춰야 함 - 비어있으면
# webhook_router.py가 모든 웹훅을 401로 거부한다.
# 실제 값은 여기에 적지 말 것(레포 public) — 백엔드팀에 물어보고 로컬 .env에만 채울 것.
REFINE_WEBHOOK_SECRET=

# REFINE_WEBHOOK_URL/REFINE_WEBHOOK_SECRET_HEADER는 STT 서버(backend/modules/stt) 쪽
# 프로세스에서만 읽는 값이라 메인 백엔드 .env에는 필요 없음 — STT 서버를 직접 띄울 때만
# 그쪽 환경에 별도로 설정한다(안 채우면 notify_refine_done이 URL 없으면 바로 리턴해서
# 웹훅 자체가 조용히 안 나감). REFINE_WEBHOOK_SECRET_HEADER는 기본값(X-Webhook-Secret)을
# 쓰면 안 넣어도 됨.
