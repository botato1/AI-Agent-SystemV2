# 이건 실제 값이 아니라 예시 파일입니다.
# 이 파일을 복사해 .env로 만들고 실제 값을 채워 사용하세요 (.env는 .gitignore에 포함되어 있습니다).
# 예: cp .env.example .env

# 데이터베이스 (필수 - 없으면 DB 연결에 실패합니다)
DATABASE_URL=postgresql+psycopg2://recall:recall@localhost:5432/recall
# Docker Compose로 실행할 경우 호스트를 localhost 대신 postgres로 지정하세요.

# Ollama (로컬 LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_LIGHT=qwen2.5:7b
OLLAMA_MODEL_HEAVY=qwen3:8b

# JWT 인증
JWT_SECRET_KEY=<임의의 랜덤 문자열>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# 암호화 (아무 문자열이나 넣으면 안 됩니다 - base64로 인코딩된 정확히 32바이트 값이어야 하며,
# 그렇지 않으면 첫 암호화 호출에서 바로 에러가 납니다. 아래 명령으로 생성하세요.
# python -c "from backend.core.crypto import generate_master_key; print(generate_master_key())"
DATA_ENCRYPTION_MASTER_KEY=<위 명령 실행 결과>
DATA_ENCRYPTION_KEY_VERSION=1

# 웹훅
REFINE_WEBHOOK_SECRET=<임의의 랜덤 문자열>

# STT 화자분리 (HuggingFace, pyannote 모델 사용 동의 필요)
HF_TOKEN=<발급받은 HuggingFace 토큰>

# 실시간 음성 인식 서버 (기본값이 개발 서버 주소이므로 로컬에서는 직접 지정)
STT_SERVER_BASE_URL=http://localhost:8002
STT_STREAM_BASE_URL=ws://localhost:8002

# SMTP (이메일 인증용, 선택)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=
