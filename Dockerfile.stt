FROM pytorch/pytorch:2.8.0-cuda12.4-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

RUN apt-get update && apt-get install -y ffmpeg curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "torchaudio>=2.8.0" \
    --index-url https://download.pytorch.org/whl/cu124

COPY backend/modules/stt/stt_requirements_v2.txt .
RUN pip install --no-cache-dir -r stt_requirements_v2.txt

# 상대 import 유지를 위해 stt/ 서브디렉토리로 복사
COPY backend/modules/stt/ ./stt/

RUN mkdir -p /app/stt/uploads

EXPOSE 8001

CMD ["python", "-m", "uvicorn", "stt.main:app", "--host", "0.0.0.0", "--port", "8001"]
